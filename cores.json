{
  "platforms": [
    "macos-arm64",
    "linux-x64"
  ],
  "cores": [
    {
      "id": "gambatte",
      "repo": "https://github.com/libretro/gambatte-libretro.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "gambatte_libretro.dylib",
      "so_out": "gambatte_libretro.so",
      "switch_repo": "ticohq/tico-gambatte"
    },
    {
      "id": "fceumm",
      "repo": "https://github.com/libretro/libretro-fceumm.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "fceumm_libretro.dylib",
      "so_out": "fceumm_libretro.so",
      "switch_repo": "ticohq/tico-fceumm"
    },
    {
      "id": "snes9x",
      "repo": "https://github.com/libretro/snes9x.git",
      "subdir": "libretro",
      "makefile": "Makefile",
      "dylib_out": "snes9x_libretro.dylib",
      "so_out": "snes9x_libretro.so",
      "switch_repo": "ticohq/tico-snes9x"
    },
    {
      "id": "mgba",
      "repo": "https://github.com/libretro/mgba.git",
      "subdir": ".",
      "build_system": "cmake",
      "cmake_target": "mgba_libretro",
      "cmake_args": [
        "-DSKIP_LIBRARY=ON",
        "-DBUILD_LIBRETRO=ON",
        "-DBUILD_QT=OFF",
        "-DBUILD_SDL=OFF",
        "-DBUILD_GL=OFF",
        "-DBUILD_GLES2=OFF",
        "-DBUILD_GLES3=OFF",
        "-DBUILD_PERF=OFF",
        "-DBUILD_SUITE=OFF",
        "-DBUILD_TEST=OFF",
        "-DBUILD_EXAMPLE=OFF",
        "-DBUILD_HEADLESS=OFF",
        "-DUSE_ZLIB=OFF",
        "-DUSE_PNG=OFF",
        "-DUSE_LIBZIP=OFF",
        "-DUSE_SQLITE3=OFF",
        "-DUSE_ELF=OFF",
        "-DUSE_FFMPEG=OFF",
        "-DUSE_DISCORD_RPC=OFF",
        "-DUSE_EPOXY=OFF",
        "-DUSE_EDITLINE=OFF",
        "-DUSE_LUA=OFF",
        "-DUSE_MINIZIP=OFF",
        "-DUSE_LZMA=OFF",
        "-DUSE_JSON_C=OFF",
        "-DUSE_FREETYPE=OFF"
      ],
      "dylib_out": "mgba_libretro.dylib",
      "so_out": "mgba_libretro.so",
      "switch_repo": "ticohq/tico-mgba"
    },
    {
      "id": "genesis_plus_gx",
      "repo": "https://github.com/libretro/Genesis-Plus-GX.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "genesis_plus_gx_libretro.dylib",
      "so_out": "genesis_plus_gx_libretro.so",
      "switch_repo": "ticohq/tico-genesisplusgx"
    },
    {
      "id": "picodrive",
      "repo": "https://github.com/libretro/picodrive.git",
      "submodules": true,
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "picodrive_libretro.dylib",
      "so_out": "picodrive_libretro.so",
      "switch_repo": "ticohq/tico-picodrive"
    },
    {
      "id": "stella",
      "repo": "https://github.com/stella-emu/stella.git",
      "ref": "7.0",
      "subdir": "src/os/libretro",
      "makefile": "Makefile",
      "cpp20": true,
      "make_args_macos": [
        "CROSS_COMPILE=1",
        "LIBRETRO_APPLE_PLATFORM=arm64-apple-macos11.0"
      ],
      "dylib_out": "stella_libretro.dylib",
      "so_out": "stella_libretro.so",
      "switch_repo": "ticohq/tico-stella",
      "settings_patch": {
        "remove": [
          "stella_detect_pal60",
          "stella_detect_ntsc50",
          "stella_messages",
          "stella_crop_voverscan",
          "stella_pal_contrast",
          "stella_pal_brightness",
          "stella_pal_hue",
          "stella_pal_saturation",
          "stella_pal_gamma",
          "stella_dpc_pitch",
          "stella_paddle_analog_deadzone",
          "stella_paddle_analog_absolute"
        ]
      }
    },
    {
      "id": "bluemsx",
      "repo": "https://github.com/libretro/blueMSX-libretro.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "bluemsx_libretro.dylib",
      "so_out": "bluemsx_libretro.so",
      "switch_repo": "ticohq/tico-blueMSX"
    },
    {
      "id": "beetle_cygne",
      "repo": "https://github.com/libretro/beetle-wswan-libretro.git",
      "subdir": ".",
      "makefile": "Makefile",
      "dylib_out": "mednafen_wswan_libretro.dylib",
      "so_out": "mednafen_wswan_libretro.so",
      "switch_repo": "ticohq/tico-beetle-cygne"
    },
    {
      "id": "beetle_vb",
      "repo": "https://github.com/libretro/beetle-vb-libretro.git",
      "subdir": ".",
      "makefile": "Makefile",
      "dylib_out": "mednafen_vb_libretro.dylib",
      "so_out": "mednafen_vb_libretro.so",
      "switch_repo": "ticohq/tico-beetle-vb"
    },
    {
      "id": "fbneo",
      "repo": "https://github.com/libretro/FBNeo.git",
      "subdir": "src/burner/libretro",
      "makefile": "Makefile",
      "dylib_out": "fbneo_libretro.dylib",
      "so_out": "fbneo_libretro.so",
      "switch_repo": "ticohq/tico-fbneo"
    },
    {
      "id": "ppsspp",
      "source": "buildbot",
      "buildbot_name": "ppsspp_libretro",
      "switch_repo": "ticohq/tico-ppsspp",
      "system_files": {
        "url": "https://buildbot.libretro.com/assets/system/PPSSPP.zip",
        "root": "PPSSPP",
        "must_contain": ["PPSSPP/ppge_atlas.zim", "PPSSPP/compat.ini", "PPSSPP/lang/en_US.ini"]
      },
      "settings_patch": {
        "remove": [
          "ppsspp_gpu_hardware_transform",
          "ppsspp_buffer_filtering",
          "ppsspp_spline_quality",
          "ppsspp_adhoc_server",
          "ppsspp_adhoc_relay_mode",
          "ppsspp_enable_adhoc_server",
          "ppsspp_nickname"
        ],
        "options": {
          "ppsspp_io_timing_method": {
            "choices": [
              {"label": "Fast", "value": "Fast"},
              {"label": "Host", "value": "Host"},
              {"label": "Simulate UMD delays", "value": "Simulate UMD delays"}
            ]
          }
        }
      },
      "extra_allowed_libs_linux": [
        "libGL.so.1"
      ]
    },
    {
      "id": "flycast",
      "source": "buildbot",
      "buildbot_name": "flycast_libretro",
      "switch_repo": "ticohq/tico-flycast",
      "settings_patch": {
        "remove": [
          "reicast_boot_to_bios"
        ]
      },
      "extra_allowed_libs_linux": [
        "libgomp.so.1"
      ]
    },
    {
      "id": "mupen64plus",
      "source": "buildbot",
      "buildbot_name": "mupen64plus_next_libretro",
      "switch_repo": "ticohq/tico-mupen64plus",
      "settings_patch": {
        "remove": [
          "mupen64plus-parallel-rsp-hle-audio",
          "mupen64plus-gliden64-resolution",
          "mupen64plus-gliden64-widescreen"
        ],
        "options": {
          "tico_renderer": {
            "key": "mupen64plus-rdp-plugin",
            "default": "gliden64",
            "choices": [
              {"label": "GLideN64 (OpenGL)", "value": "gliden64"},
              {"label": "ParaLLEl-RDP (Vulkan)", "value": "parallel"}
            ],
            "tico_only": null
          }
        }
      },
      "extra_allowed_libs_linux": [
        "libGL.so.1",
        "libmvec.so.1"
      ]
    },
    {
      "id": "dolphin",
      "source": "buildbot",
      "buildbot_name": "dolphin_libretro",
      "switch_repo": "ticohq/tico-dolphin",
      "system_files": {
        "url": "https://buildbot.libretro.com/assets/system/Dolphin.zip",
        "root": "dolphin-emu",
        "must_contain": ["dolphin-emu/Sys/codehandler.bin", "dolphin-emu/Sys/Shaders/default_pre_post_process.glsl"]
      },
      "settings_patch": {
        "remove": [
          "dolphin_renderer",
          "dolphin_sync_on_skip_idle",
          "dolphin_boost_mode",
          "dolphin_load_boost",
          "dolphin_allow_sd_writes",
          "dolphin_session_save_data_writable",
          "dolphin_correct_time_drift",
          "dolphin_sync_gpu_max_distance",
          "dolphin_sync_gpu_min_distance",
          "dolphin_sync_gpu_overclock",
          "dolphin_vsync",
          "dolphin_dpl2_decoder",
          "dolphin_audio_latency",
          "dolphin_audio_buffer_size",
          "dolphin_audio_fill_gaps",
          "dolphin_audio_volume",
          "dolphin_audio_muted",
          "dolphin_audio_mute_on_disabled_speed_limit",
          "dolphin_gc_bba",
          "dolphin_bba_dns",
          "dolphin_override_region_settings",
          "dolphin_emulate_skylander_portal",
          "dolphin_wiilink",
          "dolphin_shader_cache",
          "dolphin_backend_multithreading",
          "dolphin_cpu_cull",
          "dolphin_mipmap_detection_threshold",
          "dolphin_cap_immediate_xfb"
        ],
        "options": {
          "dolphin_dual_core": {"key": "dolphin_main_cpu_thread"},
          "dolphin_perf_queries_enable": {"key": "dolphin_per_queries_enable"},
          "dolphin_emulation_speed": {
            "choices": [
              {"label": "100%", "value": "1.0"},
              {"label": "Unlimited", "value": "0.0"}
            ]
          },
          "dolphin_cpu_clock_rate": {
            "default": "1.00",
            "choices": [
              {"label": "5%", "value": "0.05"},
              {"label": "10%", "value": "0.10"},
              {"label": "20%", "value": "0.20"},
              {"label": "30%", "value": "0.30"},
              {"label": "40%", "value": "0.40"},
              {"label": "50%", "value": "0.50"},
              {"label": "60%", "value": "0.60"},
              {"label": "70%", "value": "0.70"},
              {"label": "80%", "value": "0.80"},
              {"label": "90%", "value": "0.90"},
              {"label": "100%", "value": "1.00"},
              {"label": "150%", "value": "1.50"},
              {"label": "200%", "value": "2.00"},
              {"label": "250%", "value": "2.50"},
              {"label": "300%", "value": "3.00"}
            ]
          },
          "dolphin_language": {
            "default": "1",
            "choices": [
              {"label": "Japanese", "value": "0"},
              {"label": "English", "value": "1"},
              {"label": "German", "value": "2"},
              {"label": "French", "value": "3"},
              {"label": "Spanish", "value": "4"},
              {"label": "Italian", "value": "5"},
              {"label": "Dutch", "value": "6"},
              {"label": "Simplified Chinese", "value": "7"},
              {"label": "Traditional Chinese", "value": "8"},
              {"label": "Korean", "value": "9"}
            ]
          },
          "dolphin_vi_skip": {
            "default": "disabled",
            "choices": [
              {"label": "Disabled", "value": "disabled"},
              {"label": "Enabled", "value": "enabled"}
            ]
          }
        }
      },
      "extra_allowed_libs_linux": [
        "libEGL.so.1",
        "libX11.so.6",
        "libXi.so.6",
        "libcurl.so.4",
        "liblzma.so.5",
        "libudev.so.1",
        "libusb-1.0.so.0"
      ],
      "verify_docker_image_linux": "ubuntu:24.04"
    },
    {
      "id": "swanstation",
      "source": "buildbot",
      "buildbot_name": "swanstation_libretro",
      "platforms": ["linux-x64"],
      "switch_repo": "ticohq/tico-duckstation",
      "overlay_dir": "modules/swanstation",
      "module_overrides": {
        "id": "swanstation",
        "name": "SwanStation",
        "nro": null,
        "launch": null,
        "settings": "settings.json",
        "config_file": "swanstation.jsonc",
        "system_dir": "swanstation"
      }
    },
    {
      "id": "melondsds",
      "source": "buildbot",
      "buildbot_name": "melondsds_libretro",
      "platforms": ["linux-x64"],
      "switch_repo": "ticohq/tico-drasticDS",
      "overlay_dir": "modules/melondsds",
      "module_overrides": {
        "id": "melondsds",
        "name": "melonDS DS",
        "nro": null,
        "launch": null,
        "settings": "settings.json",
        "config_file": "melondsds.jsonc",
        "system_dir": "melondsds",
        "bool_true_value": "enabled",
        "bool_false_value": "disabled"
      },
      "system_overrides": {
        "nds": {
          "bios": null
        }
      },
      "extra_allowed_libs_linux": [
        "libmvec.so.1"
      ]
    },
    {
      "id": "azahar",
      "source": "buildbot",
      "buildbot_name": "azahar_libretro",
      "platforms": ["linux-x64"],
      "switch_repo": "ticohq/tico-azahar",
      "overlay_dir": "modules/azahar",
      "module_overrides": {
        "nro": null,
        "launch": null,
        "settings": "settings.json",
        "bool_true_value": "enabled",
        "bool_false_value": "disabled"
      },
      "extra_allowed_libs_linux": [
        "libmvec.so.1"
      ]
    },
    {
      "id": "yabasanshiro",
      "source": "buildbot",
      "buildbot_name": "yabasanshiro_libretro",
      "platforms": ["linux-x64"],
      "switch_repo": "ticohq/tico-yabasanshiro",
      "overlay_dir": "modules/yabasanshiro",
      "module_overrides": {
        "nro": null,
        "launch": null,
        "settings": "settings.json",
        "achievements": false,
        "bool_true_value": "enabled",
        "bool_false_value": "disabled"
      },
      "system_overrides": {
        "saturn": {
          "extensions": [".cue", ".iso", ".chd", ".ccd", ".mds"],
          "bios": [
            {
              "any_of": ["saturn_bios.bin"],
              "unless_option": {
                "key": "yabasanshiro_force_hle_bios",
                "value": "enabled"
              }
            }
          ]
        }
      },
      "extra_allowed_libs_linux": [
        "libGL.so.1",
        "libmvec.so.1"
      ]
    }
  ]
}
