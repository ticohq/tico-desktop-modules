{
  "platforms": [
    "macos-arm64",
    "linux-x64"
  ],
  "cores": [
    {
      "id": "gambatte",
      "repo": "https://github.com/libretro/gambatte-libretro.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "gambatte_libretro.dylib",
      "so_out": "gambatte_libretro.so",
      "switch_repo": "ticohq/tico-gambatte"
    },
    {
      "id": "fceumm",
      "repo": "https://github.com/libretro/libretro-fceumm.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "fceumm_libretro.dylib",
      "so_out": "fceumm_libretro.so",
      "switch_repo": "ticohq/tico-fceumm"
    },
    {
      "id": "snes9x",
      "repo": "https://github.com/libretro/snes9x.git",
      "subdir": "libretro",
      "makefile": "Makefile",
      "dylib_out": "snes9x_libretro.dylib",
      "so_out": "snes9x_libretro.so",
      "switch_repo": "ticohq/tico-snes9x"
    },
    {
      "id": "mgba",
      "repo": "https://github.com/libretro/mgba.git",
      "subdir": ".",
      "build_system": "cmake",
      "cmake_target": "mgba_libretro",
      "cmake_args": [
        "-DSKIP_LIBRARY=ON",
        "-DBUILD_LIBRETRO=ON",
        "-DBUILD_QT=OFF",
        "-DBUILD_SDL=OFF",
        "-DBUILD_GL=OFF",
        "-DBUILD_GLES2=OFF",
        "-DBUILD_GLES3=OFF",
        "-DBUILD_PERF=OFF",
        "-DBUILD_SUITE=OFF",
        "-DBUILD_TEST=OFF",
        "-DBUILD_EXAMPLE=OFF",
        "-DBUILD_HEADLESS=OFF",
        "-DUSE_ZLIB=OFF",
        "-DUSE_PNG=OFF",
        "-DUSE_LIBZIP=OFF",
        "-DUSE_SQLITE3=OFF",
        "-DUSE_ELF=OFF",
        "-DUSE_FFMPEG=OFF",
        "-DUSE_DISCORD_RPC=OFF",
        "-DUSE_EPOXY=OFF",
        "-DUSE_EDITLINE=OFF",
        "-DUSE_LUA=OFF",
        "-DUSE_MINIZIP=OFF",
        "-DUSE_LZMA=OFF",
        "-DUSE_JSON_C=OFF",
        "-DUSE_FREETYPE=OFF"
      ],
      "dylib_out": "mgba_libretro.dylib",
      "so_out": "mgba_libretro.so",
      "switch_repo": "ticohq/tico-mgba"
    },
    {
      "id": "genesis_plus_gx",
      "repo": "https://github.com/libretro/Genesis-Plus-GX.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "genesis_plus_gx_libretro.dylib",
      "so_out": "genesis_plus_gx_libretro.so",
      "switch_repo": "ticohq/tico-genesisplusgx"
    },
    {
      "id": "picodrive",
      "repo": "https://github.com/libretro/picodrive.git",
      "submodules": true,
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "picodrive_libretro.dylib",
      "so_out": "picodrive_libretro.so",
      "switch_repo": "ticohq/tico-picodrive"
    },
    {
      "id": "stella",
      "repo": "https://github.com/stella-emu/stella.git",
      "ref": "7.0",
      "subdir": "src/os/libretro",
      "makefile": "Makefile",
      "cpp20": true,
      "make_args_macos": [
        "CROSS_COMPILE=1",
        "LIBRETRO_APPLE_PLATFORM=arm64-apple-macos11.0"
      ],
      "dylib_out": "stella_libretro.dylib",
      "so_out": "stella_libretro.so",
      "switch_repo": "ticohq/tico-stella"
    },
    {
      "id": "bluemsx",
      "repo": "https://github.com/libretro/blueMSX-libretro.git",
      "subdir": ".",
      "makefile": "Makefile.libretro",
      "dylib_out": "bluemsx_libretro.dylib",
      "so_out": "bluemsx_libretro.so",
      "switch_repo": "ticohq/tico-blueMSX"
    },
    {
      "id": "beetle_cygne",
      "repo": "https://github.com/libretro/beetle-wswan-libretro.git",
      "subdir": ".",
      "makefile": "Makefile",
      "dylib_out": "mednafen_wswan_libretro.dylib",
      "so_out": "mednafen_wswan_libretro.so",
      "switch_repo": "ticohq/tico-beetle-cygne"
    },
    {
      "id": "beetle_vb",
      "repo": "https://github.com/libretro/beetle-vb-libretro.git",
      "subdir": ".",
      "makefile": "Makefile",
      "dylib_out": "mednafen_vb_libretro.dylib",
      "so_out": "mednafen_vb_libretro.so",
      "switch_repo": "ticohq/tico-beetle-vb"
    },
    {
      "id": "fbneo",
      "repo": "https://github.com/libretro/FBNeo.git",
      "subdir": "src/burner/libretro",
      "makefile": "Makefile",
      "dylib_out": "fbneo_libretro.dylib",
      "so_out": "fbneo_libretro.so",
      "switch_repo": "ticohq/tico-fbneo"
    },
    {
      "id": "ppsspp",
      "source": "buildbot",
      "buildbot_name": "ppsspp_libretro",
      "switch_repo": "ticohq/tico-ppsspp",
      "extra_allowed_libs_linux": [
        "libGL.so.1"
      ]
    },
    {
      "id": "flycast",
      "source": "buildbot",
      "buildbot_name": "flycast_libretro",
      "switch_repo": "ticohq/tico-flycast",
      "extra_allowed_libs_linux": [
        "libgomp.so.1"
      ]
    },
    {
      "id": "mupen64plus",
      "source": "buildbot",
      "buildbot_name": "mupen64plus_next_libretro",
      "switch_repo": "ticohq/tico-mupen64plus",
      "extra_allowed_libs_linux": [
        "libGL.so.1",
        "libmvec.so.1"
      ]
    },
    {
      "id": "dolphin",
      "source": "buildbot",
      "buildbot_name": "dolphin_libretro",
      "switch_repo": "ticohq/tico-dolphin",
      "extra_allowed_libs_linux": [
        "libEGL.so.1",
        "libX11.so.6",
        "libXi.so.6",
        "libcurl.so.4",
        "liblzma.so.5",
        "libudev.so.1",
        "libusb-1.0.so.0"
      ],
      "verify_docker_image_linux": "ubuntu:24.04"
    }
  ]
}
